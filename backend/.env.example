# AICTE VerifyAI Backend Configuration
PROJECT_NAME="AICTE VerifyAI"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server
HOST="127.0.0.1"
PORT=8000
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://localhost:3000"

# Database (PostgreSQL / Supabase or fallback local SQLite for offline dev)
DATABASE_URL="sqlite:///./aicte_verifyai.db"
# Example Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Supabase Storage (Private)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="aicte-documents"

# Sarvam Document AI API (Backend Only)
SARVAM_API_KEY="sk_sarvam_demo_key"
SARVAM_MAX_PAGES_PER_JOB=20

# JWT Auth
JWT_SECRET_KEY="aicte-verifyai-jwt-dev-secret-key-super-secure-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Limits
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS="pdf,png,jpg,jpeg"
